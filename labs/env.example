# labs/env.example — copy to labs/.env and fill in.  labs/.env is git-ignored; never commit it.
#   cp labs/env.example labs/.env && $EDITOR labs/.env && source labs/.env
# preflight.sh and checkpoint.sh read labs/.env automatically; lab commands assume you `source` it.
set -a   # export everything below so child processes (claude, uv run, node, npx) see it when you `source labs/.env`

# --- who/where -------------------------------------------------------------------------------
WORKSHOP_ORG="<WORKSHOP_ORG>"        # GitHub org that hosts the workshop repos (your facilitator tells you)
GITHUB_USER="<you>"                  # your GitHub username (owner of your astroshop-reviews copy)

# --- local paths (absolute) ------------------------------------------------------------------
WS="$HOME/work/claude-builders-workshop"      # this repository
OTEL="$HOME/work/opentelemetry-demo"          # your clone of github.com/$WORKSHOP_ORG/opentelemetry-demo
REV="$HOME/work/astroshop-reviews"            # your clone of github.com/$GITHUB_USER/astroshop-reviews
WORKSHOP_REPO="$WS"                           # used by the plugin's .mcp.json env expansion (M3)

# --- Anthropic API (Console) -----------------------------------------------------------------
# Strictly required for: M4 Path B (GitHub Actions), M5 (Agent SDK), M6 (Managed Agents), M7 step 5.
# Leave empty if you only have a claude.ai subscription seat; you will pair for those parts.
# NOTE: when this is set, `claude -p` (headless) bills the key, not your subscription.
ANTHROPIC_API_KEY=""

# Model alias used by `claude -p` scripts (M4) and the Agent SDK code (M5). Claude Code and the SDK accept
# aliases (`sonnet`, `opus`, `haiku`), so this never needs a dated model ID; bump here only.
MODEL="sonnet"

# Full model ID for the Managed Agents lab (M6). The Managed Agents API does NOT accept Claude Code aliases
# (`sonnet` returns 400) — paste the current full ID of a Claude 4.5+ model your org can use (see reference §B).
# Module 7 step 5 reuses the same value for the GitHub Action's `CLAUDE_MODEL` repo variable.
CMA_MODEL="<full-model-id — see reference §B>"

# Language track for M5/M6 starters and checkpoints: python | typescript
TRACK="python"

# --- facilitator-maintained (do not edit unless told) -----------------------------------------
OTEL_PINNED_SHA=""                    # commit the workshop fork's `workshop` branch is pinned to
PREFLIGHT_MIN_CLAUDE_VERSION=""       # optional floor for `claude --version`; empty = report only
PREFLIGHT_MIN_NODE_MAJOR="22"
PREFLIGHT_MIN_PYTHON="3.10"
MANAGED_AGENTS_BETA="managed-agents-2026-04-01"   # beta header used by preflight's access probe (verify before each delivery)

set +a
